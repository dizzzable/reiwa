# ═══════════════════════════════════════════════════════════════════════════════
#  reiwa — Environment Configuration
#
#  Reiwa is the user-facing edge service for Rezeis.
#  It connects to rezeis-admin for all business logic.
#
#  Copy this file to .env and fill in the values marked with "change_me".
# ═══════════════════════════════════════════════════════════════════════════════

# - - - - - REIWA CONFIGURATION - - - - - #
# Public domain of the reiwa web/Mini App. Used by the bot to build webApp
# buttons, referral links and payment-return URLs, and by the API for
# CORS / CSRF allow-list.
#
# Format: just the bare host, e.g. `reiwa.example.com`. The protocol is
# inferred — public domains get `https://` (Telegram requires it for
# webApp buttons), `localhost`/`localhost:PORT` and docker service names
# get `http://`. Full URLs (`https://...`) are also accepted.
#
# Single-image note: the API serves the SPA on REIWA_PORT, so same-origin
# browser requests are always accepted by CSRF regardless of this value.
# Set it to the public host users actually open — e.g. `app.example.com`
# in prod (behind the reverse proxy) or `127.0.0.1:5000` for a local
# unified-image test.
REIWA_DOMAIN=change_me
REIWA_HOST=0.0.0.0
REIWA_PORT=5000
# Optional: explicit CORS / CSRF allow-origin for the API. Leave unset to
# derive it from REIWA_DOMAIN (the common case). Set only when the browser
# origin differs from the public domain (e.g. a separate front-end host).
# REIWA_CORS_ORIGIN=

# - - - - - REZEIS CONFIGURATION - - - - - #
# Connection to rezeis-admin panel (source of truth for all business logic).
#
# TOPOLOGY — this is the one line that changes when you split the stack:
#   • Single host (default): REZEIS_HOST=rezeis — the panel's docker service
#     name on the shared `remnawave-network`. Resolves to http://rezeis:8000.
#   • Split VPS (panel and cabinet on different hosts): REZEIS_HOST MUST be the
#     panel's PUBLIC domain, e.g. panel.example.com. A docker service name does
#     not exist outside its own host — leave `rezeis` here and every business
#     call goes to http://rezeis:8000, fails DNS, and the cabinet answers 503
#     with nothing at all in the panel's log (the requests never reached it).
#     reiwa-api warns about exactly this once at boot; grep the startup log for
#     REZEIS_HOST.
#
# How the value is turned into a URL (src/core/config/url-resolver.ts):
# REZEIS_HOST without a dot = docker service name → http://<host>:<port>
# (single-VPS default; must match the rezeis container name, which is `rezeis`).
# REZEIS_HOST that is a PRIVATE address (loopback, 10./192.168./172.16-31.,
# localhost) → http://<host>:<port> — a literal is not a domain.
# REZEIS_HOST reachable from the internet = domain or routable IP →
# https://<host>, port ignored (split-VPS; TLS terminates at 443 on the proxy).
REZEIS_HOST=rezeis
REZEIS_PORT=8000
# Адрес панели, закреплённый в обход DNS. НЕ НУЖЕН в обычной установке —
# оставьте пустым.
#
# Читается ТОЛЬКО оверлеем docker-compose.pin-panel.yml, а не приложением.
# Заводится, когда панель на другом VPS и резолвер у провайдера ненадёжен:
# `getaddrinfo EAI_AGAIN` кладёт все обращения к панели разом, они висят до
# таймаута и отвечают 503, а в логе панели пусто — запросы до неё не дошли.
#
# ⚠️  Прибитый адрес не устаревает сам. Панель переехала или сменила IP —
#     кабинет будет молча стучаться в мёртвый адрес, и это хуже временного
#     сбоя DNS, который проходит сам. Прежде чем заводить, почините резолверы
#     на уровне демона Docker: /etc/docker/daemon.json → { "dns": [...] }.
#     Так чинится и панель, и api.telegram.org, и ничего не устаревает.
#
#   dig +short <значение REZEIS_HOST>
# REZEIS_HOST_IP=
# Bearer token for every reiwa → rezeis-admin API call.
#
# YOU CANNOT INVENT THIS VALUE. It is ISSUED BY THE PANEL: open rezeis-admin →
# Settings → API tokens → create a token, and paste the string it shows you
# (shown once, at creation). The panel verifies it as a JWT signed with its own
# key and then looks the token's row up in its `api_tokens` table, checking the
# fingerprint, the audience and the expiry. A hand-written string — however long
# or random — is rejected with 401 "Invalid API token" on every single request,
# and the cabinet is dead until a real token is pasted here.
# Revoking or expiring the token in the panel takes effect immediately.
REZEIS_TOKEN=change_me
# HMAC shared secret. It has TWO roles, and the first one CROSSES HOSTS:
#   1. reiwa-api/bot/worker → rezeis-admin: signs every outbound REST/SSE call
#      (x-request-signature). rezeis-admin VERIFIES that signature using its own
#      REZEIS_INTERNAL_SHARED_SECRET.
#   2. reiwa-api → reiwa-bot (private docker hop on THIS host): signs the relay
#      of received rezeis webhooks to the bot's internal listener.
#
# MUST BE BYTE-IDENTICAL to rezeis-admin's REZEIS_INTERNAL_SHARED_SECRET.
# Generate it once and paste the same string into BOTH .env files. This is not
# a reiwa-only value — earlier revisions of this file and of
# docs/split-vps-deployment.md claimed the admin does not need it. That was
# wrong, and it is the mistake that takes the cabinet down.
#
# If the two values differ, what happens depends on the panel's
# REZEIS_INTERNAL_SIGNATURE_MODE:
#   • log (the panel's default) — every request is still ALLOWED, and the panel
#     logs `internal signature ... allowed (mode=log)` for each one. Nothing
#     visibly breaks, so a mismatch can sit there for months while the second
#     factor you think you configured protects nothing.
#   • require — every reiwa → rezeis request is rejected with 401. The entire
#     cabinet stops: sign-in, subscriptions, payments, support, bot.
# So a mismatch is invisible until the operator hardens the panel, and at that
# moment it is a total outage. Always set the two sides together.
#
# At least 32 characters; reiwa refuses to start in production without it.
# Generate:  openssl rand -hex 32
REZEIS_INTERNAL_SHARED_SECRET=change_me

# Secret to VERIFY inbound webhooks from rezeis-admin (operator events:
# bot-config changed, per-user notifications, broadcasts). Must equal the
# admin's WEBHOOK_SECRET_HEADER byte for byte (this is the Remnawave→remnashop
# "REMNAWAVE_WEBHOOK_SECRET" equivalent). admin signs
# `X-Rezeis-Signature: t=<sec>,v1=<hmac>`; reiwa-api receives on
# https://<REIWA_DOMAIN>/api/v1/webhooks/rezeis and relays to the bot
# locally. When unset, the webhook receiver rejects everything.
#
# FORMAT: 64–256 alphanumeric characters ([a-zA-Z0-9]). Generate with
#   openssl rand -hex 32
# which is exactly 64 hex characters and satisfies both sides.
# reiwa itself does NOT check the format — it accepts any non-empty string —
# but the panel's schema documents 64–256 alphanumeric and prints a boot warning
# for anything else. So a short or punctuated secret can look fine here and
# still be outside the contract on the panel side; generate it on the panel's
# terms and paste the identical string into both files.
REZEIS_WEBHOOK_SECRET=change_me

# - - - - - BOT CONFIGURATION - - - - - #
# The bot runs on long-polling (no webhook). It always registers its slash
# commands (setMyCommands) and drops pending updates only on a cold start —
# so there are NO BOT_SETUP_WEBHOOK / BOT_RESET_WEBHOOK / BOT_SETUP_COMMANDS /
# BOT_DROP_PENDING_UPDATES knobs. The Mini App is toggled from the admin panel
# (Bot features), not via env. BOT_TOKEN is mandatory in production: the bot
# process fails fast with exit code 1 when it is missing or empty. It may be
# omitted only for development/test runs where the bot is intentionally disabled.
BOT_TOKEN=change_me
BOT_SUPPORT_USERNAME=change_me
BOT_DEV_ID=change_me

# ── Local Bot API Server (OPT-IN, for backups > 50 MB) ───────────────────────
# By default the bot uses Telegram's cloud API (50 MB sendDocument cap). To
# deliver large DB backups (up to 2 GB) point the bot at a self-hosted Local
# Bot API Server:
#   1. Get TELEGRAM_API_ID + TELEGRAM_API_HASH from https://my.telegram.org
#   2. Start the server:  docker compose --profile bigfiles up -d
#   3. Set the URL below so the bot routes through it.
# One-time: a bot already used on the cloud API must log out of it before its
# first use on a local server (call the cloud logOut once).
# TELEGRAM_BOT_API_ROOT=http://telegram-bot-api:8081
# TELEGRAM_API_ID=change_me
# TELEGRAM_API_HASH=change_me

# Telegram bot username WITHOUT the leading "@", e.g. RezeisBot.
# Used to build the t.me/<BOT_USERNAME>?start=payment_return deep link that
# brings users back to the bot (and into the Mini App via menu button)
# after returning from a payment provider in Telegram context.
BOT_USERNAME=RezeisBot
# Optional: TCP port the bot's internal cache-invalidate listener BINDS to.
# reiwa-api relays received rezeis webhooks there over the private docker
# network. Defaults to 5100; only change it on a non-standard local topology.
# The listener is skipped entirely unless REZEIS_INTERNAL_SHARED_SECRET is set.
# BOT_INVALIDATE_PORT=5100
# Optional: the address reiwa-api DIALS for that same relay (the other half of
# BOT_INVALIDATE_PORT above). Defaults to http://reiwa-bot:5100 — the bot
# container's service name plus the port.
#
# This one is a docker service name ON PURPOSE and stays that way on BOTH
# topologies: reiwa-api and reiwa-bot always live on the same host, in the same
# compose stack, and the bot is never exposed publicly. Do NOT change it to a
# public URL when you split panel and cabinet across VPSes — only REZEIS_HOST
# moves. Override it only for a genuinely non-standard local layout (e.g. the
# bot running outside docker, or a renamed container). If you change
# BOT_INVALIDATE_PORT you must change the port here too, or the relay silently
# stops and bot config only refreshes on its 5-minute TTL.
# REIWA_BOT_INTERNAL_URL=http://reiwa-bot:5100

# - - - - - AI CHAT (panel-managed) - - - - - #
# Do NOT put provider API keys here. AI-Support is configured in rezeis-admin
# panel (Настройки → AI-Support): OpenAI-compatible base URL, encrypted API
# key (AES-GCM via REZEIS_CRYPT_KEY), model picker, system prompt, instructions.
# Reiwa pulls decrypted settings over the internal BFF channel only.
# Legacy OPENAI_API_KEY / OPENAI_API_URL / OPENAI_MODEL env vars are ignored.

# - - - - - DATABASE - - - - - #
# reiwa is a stateless edge service. The Postgres source of truth lives in
# rezeis-admin and is reached over HTTP via REZEIS_HOST / REZEIS_PORT.
# Reiwa keeps no relational state of its own. All ephemeral state
# (sessions, rate-limit counters, FSM, linking codes, install banners)
# lives in reiwa-redis below.

# - - - - - BRANDING ASSET CACHE (optional) - - - - - #
# Disk mirror of operator branding assets (logo / PWA icon) proxied from
# rezeis-admin under /uploads/branding/*. Lets the brand survive an admin-panel
# outage (fetch-once → serve-from-cache).
#
# KEEP THIS SET IN DOCKER. Unset, it falls back to <cwd>/.cache/branding, which
# in a container is the container's own writable layer — not a volume. The cache
# then works exactly as documented until the next `docker compose pull` /
# `up -d`, which replaces the container and discards it. Nothing warns: the
# mirror silently re-empties on every update, so the "brand survives an admin
# outage" guarantee is void precisely when it is needed. The value below matches
# the `reiwa-branding-cache` volume mounted at /data/branding-cache in
# docker-compose.yml; change one and you must change the other.
BRANDING_CACHE_DIR=/data/branding-cache

# - - - - - REDIS CONFIGURATION - - - - - #
# Reiwa's own Redis (sessions, rate limiting, bot FSM state)
REDIS_HOST=reiwa-redis
REDIS_PORT=6379
REDIS_NAME=0
REDIS_PASSWORD=change_me

# - - - - - WEB SESSION / COOKIE SECURITY - - - - - #
# Opaque random session id stored in Redis; the cookie is httpOnly + SameSite=Lax.
# Session cookies contain an opaque random UUID. Redis lookup is the authority;
# cookies are not signed because modifying an ID cannot grant a valid session.
# Issue session cookies with the `Secure` flag (HTTPS only). In production the
# app forces Secure cookies on regardless; set this to `true` in any HTTPS env.
REIWA_COOKIE_SECURE=true
# Escape hatch: allow non-`Secure` session cookies in production (trusted
# internal network / out-of-band TLS only). Leave `false` unless you know
# exactly why you need it — otherwise the API fails closed at startup rather
# than silently downgrading session security.
REIWA_ALLOW_INSECURE_COOKIES=false

# - - - - - DEGRADED MODE - - - - - #
# Redis backs web sessions, the rate limiter and brute-force detection. In
# production the API fails closed (refuses to start) when Redis is
# unreachable, because booting without it silently disables those
# protections. Set to `true` only to intentionally boot without Redis
# (local smoke tests, emergency degraded operation). Non-production always
# allows degraded boot regardless of this flag.
REIWA_ALLOW_DEGRADED=false

# - - - - - ANONYMOUS SUPPORT CHAT (optional) - - - - - #
# Captcha is now configured from the rezeis admin panel (Support tickets →
# Settings) and fetched by reiwa at runtime — you normally do NOT need to set
# anything here. These env vars are kept only as a legacy seed/fallback for
# the rezeis side; the reiwa edge reads the effective values from rezeis.
SUPPORT_TURNSTILE_SECRET=
SUPPORT_TURNSTILE_SITE_KEY=
