# reiwa user app — Caddy reverse proxy (443-only, bring-your-own cert)
#
# Replace REPLACE_WITH_YOUR_DOMAIN with the app hostname (e.g.
# app.example.com).
#
# No ACME, no port 80. TLS is served from a certificate you provide in
# ./certs (self-signed via ../gen-self-signed-cert.sh, a Cloudflare Origin
# cert, or one you issued yourself). The reiwa container serves BOTH the
# SPA and the /api/* BFF on :5000 (single image), so the proxy forwards
# everything to reiwa:5000.
{
	# We don't bind :80 — disable the automatic HTTP->HTTPS redirect vhost.
	auto_https disable_redirects

	# Real client IP — not needed today, REQUIRED if you ever put a CDN
	# (Cloudflare) in front of this VPS.
	#
	# Today this box terminates TLS directly, so the peer address IS the
	# client. Behind a CDN, every request arrives from an edge address; if
	# Caddy has not been told which peers to trust, the app treats that
	# edge as the client and:
	#   - the cabinet bans an offending IP for 24 HOURS — one abuser behind
	#     a given Cloudflare datacentre locks out every legitimate user
	#     routed through it, for a day;
	#   - the rezeis panel auto-blocks for 30 MINUTES on repeated failed
	#     logins — same blast radius, shorter fuse.
	# Rate limiting, abuse heuristics and audit logs all go wrong the same
	# way, invisibly, until users complain.
	#
	# To enable: fetch the CURRENT ranges from Cloudflare's published list
	# at https://www.cloudflare.com/ips/ (IPv4 and IPv6 — they change) and
	# list them after `static`. Never use 0.0.0.0/0: that trusts every peer
	# and lets any client forge its own address.
	#
	# servers {
	# 	trusted_proxies static <cloudflare-cidr> <cloudflare-cidr> ...
	# 	client_ip_headers CF-Connecting-IP
	# }
	#
	# The sibling stacks need their own equivalent:
	#   nginx/angie — `set_real_ip_from` + `real_ip_header CF-Connecting-IP`
	#   traefik     — `entryPoints.https.forwardedHeaders.trustedIPs`
	# Traefik is the worst of the four here: when the peer is NOT trusted it
	# STRIPS every X-Forwarded-* header instead of shifting/appending, so the
	# client address is destroyed outright rather than merely wrong. Caddy
	# and nginx/angie leave a wrong-but-present value; Traefik leaves none.
}

# ┌──────────────────────────────────────────────────────────────────────────┐
# │  UPSTREAM PORT IS HARD-CODED — THE 5000 BELOW IS NOT READ FROM .env      │
# └──────────────────────────────────────────────────────────────────────────┘
#
# The cabinet's docker-compose.yml publishes `${REIWA_PORT:-5000}` and the app
# listens on `PORT ?? REIWA_PORT`, so the port IS a variable there. Here it is
# a literal, and the proxy stacks in this folder load no .env at all.
#
# Change REIWA_PORT in the cabinet's .env and this file still dials 5000. The
# port is closed, so every request dies at the edge with a 502; the app logs
# NOTHING, because no request ever reaches it; and `docker compose ps` reports
# both containers healthy. Nothing in either log points at the cause.
#
# This is deliberately NOT solved with an environment variable: this project
# keeps its settings in the panel and adds nothing to .env. If you change the
# port, change it BY HAND here — in BOTH `reverse_proxy` lines below — and in
# every other file listed under "Upstream port" in ../README.md.

https://REPLACE_WITH_YOUR_DOMAIN {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.key

	# HSTS — one year. After one visit, browsers refuse plaintext HTTP to
	# this host until the max-age expires.
	#
	# `includeSubDomains` is a commitment, not just a hardening flag: it
	# pins HTTPS for EVERY name under this one. If this host ever shares an
	# apex with another (e.g. app.example.com and panel.example.com both
	# under example.com), the header served from either one applies to the
	# whole example.com tree — including subdomains that have no cert yet,
	# which then become unreachable in any browser that saw the header, for
	# a year. If your DNS layout makes that risky, drop `includeSubDomains`;
	# the max-age alone still protects this host.
	#
	# Deliberately NOT `preload`. Preload is a one-way submission to browser
	# vendors — removal takes months and rides browser release trains. Add
	# it only as a separate, conscious decision.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# ── The ONE long-lived route ──────────────────────────────────────
	#
	# `GET /api/v1/realtime/stream` is the only streaming endpoint this app
	# has (`text/event-stream`, held open for hours). There are no
	# WebSockets anywhere in the cabinet — grep for them and you find none,
	# and nothing in the app ever answers a 101.
	#
	# `flush_interval -1` used to sit on `reverse_proxy *`, i.e. on
	# EVERYTHING. Splitting it out is what lets the catch-all below carry a
	# FINITE wait, which is the defect that actually mattered: with no
	# `response_header_timeout` anywhere, an upstream that accepts the
	# connection and then never answers holds the request — and the browser
	# tab — open forever, logging nothing on either side.
	#
	# It matters most in the split-VPS layout this repo supports: the SPA
	# document calls the panel on ANOTHER HOST before its first byte, so a
	# panel outage turns every page load into a slow request. The edge must
	# cut those off quickly. It must not cut off the stream.
	#
	# Ordering is not left to chance: Caddy sorts `handle` blocks by matcher
	# specificity and sorts the matcher-less block LAST, so this one stays
	# ahead of the catch-all whatever order they are written in. An inline
	# path with no trailing `*` is an EXACT match — `/foo` matches only
	# `/foo` — the equivalent of nginx's `location = /...`.
	handle /api/v1/realtime/stream {
		reverse_proxy http://reiwa:5000 {
			# Low-latency mode: every write goes to the client as it
			# arrives. Caddy does not buffer response bodies by default,
			# but without this it never flushes early either, so a
			# subscriber sees nothing until some buffer happens to fill.
			#
			# Deliberately no `transport http` block: this is the one route
			# allowed to wait indefinitely.
			flush_interval -1
		}
	}

	# Everything else: ordinary buffered proxying, bounded wait.
	handle {
		reverse_proxy http://reiwa:5000 {
			transport http {
				# The directive that was missing. Caddy's default is NO
				# TIMEOUT. 60s is the ceiling for producing a response —
				# the SPA document legitimately takes seconds when the
				# panel is slow, so this is generous, but it is FINITE.
				#
				# `dial_timeout` is deliberately left alone: Caddy already
				# defaults to 3s, tighter than the 5s the nginx and angie
				# templates have to set by hand.
				#
				# There is no `read_timeout` or `write_timeout` in
				# `transport http` — do not invent them, Caddy refuses to
				# start on an unrecognised sub-directive. The client-side
				# write deadline exists only as the global
				# `servers { timeouts { write } }`, and it is deliberately
				# NOT set: that block is server-wide with no per-route
				# override, so any value there would also apply to the
				# stream above and cut every subscriber off at exactly
				# that age.
				response_header_timeout 60s
			}
		}
	}
}

# Stealth default: TLS connections without the right SNI get a self-signed
# handshake + empty 204, so the app hostname isn't discoverable by IP scan.
:443 {
	tls internal
	respond 204
}
